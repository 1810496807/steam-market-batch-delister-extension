{
  "manifest_version": 3,
  "name": "Steam 市场批量助手 (Steam Market Batch Assistant)",
  "version": "2.2.1",
  "minimum_chrome_version": "99",
  "description": "批量下架在售商品，并生成 Steam 官方批量上架页面。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Steam 市场批量助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/market/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.css"
      ],
      "matches": [
        "https://steamcommunity.com/*"
      ]
    }
  ]
}
